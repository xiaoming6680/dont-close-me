// Cloudflare 部署配置（新版 Pages = Workers 静态资源）。
// 只上传 dist/（先跑 python tools/dist.py）：docs/ 是完整剧透、tests/ 是测试、规划文件是工作记录，都不能上线。
{
  "name": "dont-close-me",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist"
  },
  // 线上地址：https://stay.xiaoming6680.link（xiaoming6680.link 在同一个 Cloudflare 账号里，DNS 和证书自动配）
  "routes": [{ "pattern": "stay.xiaoming6680.link", "custom_domain": true }],
  // 只用正式域名，不开 workers.dev 和预览地址
  "workers_dev": false,
  "preview_urls": false,
  // 不开请求日志：游戏承诺不收集任何数据
  "observability": {
    "enabled": false
  }
}
